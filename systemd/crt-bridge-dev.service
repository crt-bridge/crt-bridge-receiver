[Unit]
Description=crt-bridge developer mode (crtbridge.dev=1 on the kernel command line)
# Without the word crtbridge.dev=1 on the kernel command line this unit is
# skipped, and ssh stays closed.
ConditionKernelCommandLine=crtbridge.dev=1
# No Wants= or Requires= on sshd.service, ever: systemd pulls in what a unit
# wants even when the unit's condition skips it. dev-mode starts sshd itself,
# once the key on the command line has passed its check.
Before=crt-bridge-config.service
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/crt-bridge/dev-mode
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
