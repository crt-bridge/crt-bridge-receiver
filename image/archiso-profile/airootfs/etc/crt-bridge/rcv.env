# /etc/crt-bridge/rcv.env -- the receiver image's defaults.
#
# Read by crt-bridge-rcv.service and crt-bridge-volume.service, BEFORE
# /run/crt-bridge/user.env: that file holds what was read from the boot stick
# (settings.ini, monitor.ini) and replaces every variable it sets. Change a
# setting on the stick, not here: this file is part of the image.
#
# HDA_VOLUME is expanded WITH braces in ExecStart= (${HDA_VOLUME}): one value,
# one argument. DAEMON_OPTS is expanded WITHOUT braces ($DAEMON_OPTS): it is
# split on spaces, so several options fit in it. See systemd.service(5),
# section "Command Lines": the asymmetry is deliberate.
#
# DAEMON_OPTS is empty. No monitor file: the daemon uses its built-in 15 kHz
# band. No CPU pinning: the one measurement made on the bench (three cores
# tried for the audio thread) found no difference. A value here must rest on
# a measurement, not on a guess.
HDA_VOLUME=75
DAEMON_OPTS=
